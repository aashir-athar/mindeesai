# =====================================================================
# MindeesAI — Environment Variables
# Copy this file to `.env.local` and fill in what you need.
# Everything is OPTIONAL except where noted. The system degrades
# gracefully — missing keys disable that capability rather than crash.
# =====================================================================

# ---------- CORE ----------
# Public site URL (used for absolute links, OG images, cron-job.org target)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required — random 32-byte hex.  Generate with:  openssl rand -hex 32
CRON_SECRET=replace-me-with-a-32-byte-hex-string

# ---------- LLM: LOCAL OLLAMA (default + recommended free path) ----------
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=deepseek-r1:32b
FAST_CHAT_MODEL=llama3.1:8b
CODE_MODEL=qwen2.5-coder:32b
DEFAULT_EMBED_MODEL=nomic-embed-text:latest

# ---------- LLM: OPTIONAL VENDOR FALLBACKS ----------
# Any of these enable the corresponding provider in the LLM router.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------- RESEARCH ----------
# Tavily — free tier 1000/mo.  https://tavily.com
TAVILY_API_KEY=

# Exa — fallback search.  https://exa.ai
EXA_API_KEY=

# Firecrawl — deep page read.  Free tier.  https://firecrawl.dev
FIRECRAWL_API_KEY=

# Jina Reader — second fallback.  Free, no key required.
JINA_API_KEY=

# ---------- MEMORY ----------
# LanceDB local path (file-backed, embedded).
# On Vercel set this to /tmp/lancedb (read-only filesystem elsewhere).
LANCEDB_PATH=./data/lancedb

# Persistence mode: local | cloudflare-r2 | vercel-blob | turso | external
# - local          → dev + self-hosted (default)
# - cloudflare-r2  → /tmp scratch + snapshot to R2 (recommended for prod)
# - vercel-blob    → /tmp scratch + snapshot to Vercel Blob (Hobby plan
#                    caps writes at 2k/mo — the cron burns this fast)
# - turso          → libsql vector store
# - external       → LANCEDB_PATH points at a mounted network volume
#
# Leave UNSET to auto-detect: R2 if R2_* are set on Vercel, else Blob if
# BLOB_READ_WRITE_TOKEN is set, else local.
MEMORY_PERSISTENCE=local

# ---------- CLOUDFLARE R2 (recommended free-tier prod storage) ----------
# 10 GB storage, 1M writes/mo, 10M reads/mo, $0 egress forever.
#
# Setup:
#   1. https://dash.cloudflare.com → R2 → Create bucket (e.g. "mindeesai")
#   2. R2 → Manage R2 API Tokens → Create API token → Object Read & Write
#   3. Copy Access Key ID + Secret Access Key + Account ID below
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public R2 hostname for read-only fetches (e.g. pub-<hash>.r2.dev
# or a custom domain). Used by audit pages that link to artefacts.
R2_PUBLIC_URL=

# ---------- VERCEL BLOB (only when MEMORY_PERSISTENCE=vercel-blob) ----------
# Get a token at: Vercel dashboard → Storage → Blob → Connect Store.
# Hobby caps at 2k writes/mo — fine for low-frequency use, NOT for 5-min cron.
BLOB_READ_WRITE_TOKEN=

# ---------- HUGGINGFACE HUB (where the trained checkpoint lives) ----------
# The cold-start path fetches base.bin from this repo, caches to /tmp,
# and loads it into the native model.  Public repo, no auth needed for reads.
HF_MODEL_REPO=aashir-athar/mindeesai-base
HF_MODEL_FILE=base.bin
HF_MODEL_REVISION=main
# Only needed for the upload script (scripts/upload_to_hf.py):
HF_TOKEN=

# ---------- VERCEL DEPLOYMENT (automatically populated on Vercel) ----------
# Vercel injects these — you do NOT need to set them yourself.
# Listed here so you know they're available inside your functions.
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=mindeesai.vercel.app
# VERCEL_REGION=iad1

# ---------- TELEMETRY (opt-in) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=

# ---------- FEATURE FLAGS ----------
ENABLE_WEB_RESEARCH=true
ENABLE_SELF_REFLECTION=true
ENABLE_CONNECTOR_SANDBOX=true
ENABLE_VISION=false
