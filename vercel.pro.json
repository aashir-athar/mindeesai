{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "Pro-plan overrides — replace vercel.json with this file when you upgrade. Adds the 5-minute Vercel Cron job and bumps memory + duration for the heavy ML functions.",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs && next build",
  "installCommand": "pnpm install --no-frozen-lockfile || npm install",
  "regions": ["iad1"],
  "github": {
    "silent": false
  },
  "functions": {
    "app/api/cron/self-improve/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/chat/route.ts": {
      "maxDuration": 60,
      "memory": 1769
    },
    "app/api/benchmark/route.ts": {
      "maxDuration": 120,
      "memory": 1769
    },
    "app/api/connectors/run/route.ts": {
      "maxDuration": 30
    },
    "app/api/memory/search/route.ts": {
      "maxDuration": 15
    },
    "app/api/health/route.ts": {
      "maxDuration": 10
    },
    "app/api/feedback/route.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/self-improve",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "MEMORY_PERSISTENCE": "vercel-blob",
    "LANCEDB_PATH": "/tmp/lancedb"
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]},
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
    ]},
    { "source": "/api/health", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Cache-Control", "value": "public, max-age=15, s-maxage=15" }
    ]}
  ],
  "redirects": [
    { "source": "/github", "destination": "https://github.com/aashir-athar/mindeesai", "permanent": false },
    { "source": "/docs",   "destination": "https://github.com/aashir-athar/mindeesai#table-of-contents", "permanent": false }
  ]
}
