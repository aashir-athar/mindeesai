{
  "name": "mindeesai",
  "version": "0.2.0",
  "description": "A native, self-training open-source AI — DeepSeek-V3-class architecture with MoE, MLA, MTP, GRPO.",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node scripts/bootstrap.mjs",
    "vercel-build": "node scripts/vercel-build.mjs && next build",
    "tokenizer:train": "python scripts/train/tokenizer_train.py",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "sidecar:dev": "npm --prefix scripts/sidecar run dev",
    "sidecar:start": "npm --prefix scripts/sidecar start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashir-athar/mindeesai.git"
  },
  "keywords": [
    "ai",
    "llm",
    "open-source-llm",
    "self-training",
    "continual-learning",
    "lora",
    "dpo",
    "grpo",
    "transformer",
    "moe",
    "mla",
    "deepseek",
    "nextjs-16",
    "react-19",
    "typescript",
    "tailwindcss",
    "lancedb",
    "rag",
    "autonomous-ai",
    "mindees-ai"
  ],
  "author": "Aashir Athar <iamaashirathar@gmail.com> (https://github.com/aashir-athar)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aashir-athar/mindeesai/issues"
  },
  "homepage": "https://github.com/aashir-athar/mindeesai#readme",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.23.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/blob": "^2.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}
