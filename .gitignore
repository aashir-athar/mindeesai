# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build
/dist

# Environment / secrets — only .env.example is tracked
.env
.env.*
!.env.example
.env*.local
.env.production

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test
coverage

# IDE
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store

# Runtime data (gitkeep'd subfolders are tracked, contents are not)
/data/lancedb/
/data/conversations/*
/data/reflections/*
/data/system-prompt-archive/*
/data/cache/*
!/data/**/.gitkeep
/data/system-prompt.json
/data/graph.json
/data/retrieval-weights.json
/data/improvement-log.jsonl

# Connector-local secrets
/connectors/**/.secrets
