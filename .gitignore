# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build
/dist

# Environment / secrets — only .env.example is tracked
.env
.env.*
!.env.example
.env*.local
.env.production

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test
coverage

# IDE
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store

# Claude Code local session state — must NEVER be tracked
.claude/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store

# Runtime data — ignore the WHOLE /data/ tree, keep only .gitkeep markers.
# Every file under /data/ is per-deployment runtime state (memory, tensors,
# logs, conversations, distill corpus, journals, etc.) that should NEVER
# end up in source control. Production state lives in Vercel Blob.
/data/*
!/data/.gitkeep
!/data/**/.gitkeep

# Trained model checkpoints — large binary artefacts, regenerated by the
# pretrain workflow. Production state lives in Vercel Blob.
/checkpoints/*
!/checkpoints/.gitkeep

# Connector-local secrets
/connectors/**/.secrets
